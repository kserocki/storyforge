{
    "name": "storyforge",
    "private": true,
    "type": "module",
    "scripts": {
        "typecheck": "pnpm -r typecheck",
        "test": "pnpm -r test",
        "clip": "pnpm --filter @storyforge/runway-client clip",
        "db:up": "docker compose -f infra/docker-compose.yml up -d --wait",
        "db:down": "docker compose -f infra/docker-compose.yml down",
        "db:psql": "docker exec -it storyforge-db psql -U storyforge",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "worker": "pnpm --filter @storyforge/worker start",
        "ftt": "pnpm format && pnpm -r typecheck && pnpm -r test"
    },
    "devDependencies": {
        "@types/node": "^26.6.5",
        "prettier": "^3.9.10",
        "tsx": "^4.23.15",
        "typescript": "^7.0.2"
    }
}
